@model CarInsurance.Models.Insuree

@{
    ViewData["Title"] = "Delete";
}

<h2>Delete Insuree</h2>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Insurance Quote Information</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FirstName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.FirstName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.LastName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.LastName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EmailAddress)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.EmailAddress)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DateOfBirth)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.DateOfBirth)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CarYear)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CarYear)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CarMake)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CarMake)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CarModel)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.CarModel)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DUI)</dt>
        <dd class="col-sm-9">@(Model.DUI ? "Yes" : "No")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.SpeedingTickets)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.SpeedingTickets)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.CoverageType)</dt>
        <dd class="col-sm-9">@(Model.CoverageType ? "Full Coverage" : "Liability Only")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Quote)</dt>
        <dd class="col-sm-9"><strong>@Model.Quote.ToString("C")</strong></dd>
    </dl>
    
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Admin" class="btn btn-secondary">Cancel</a>
    </form>
</div>
