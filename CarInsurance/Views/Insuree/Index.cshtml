@model CarInsurance.Models.Insuree

@{
    ViewData["Title"] = "Get Car Insurance Quote";
}

<h2>Get Your Car Insurance Quote</h2>

<hr />
<div class="row">
    <div class="col-md-8">
        <form asp-action="Index" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            
            <h4>Personal Information</h4>
            <div class="form-group mb-3">
                <label asp-for="FirstName" class="form-label"></label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="LastName" class="form-label"></label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="EmailAddress" class="form-label"></label>
                <input asp-for="EmailAddress" class="form-control" />
                <span asp-validation-for="EmailAddress" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="DateOfBirth" class="form-label"></label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <h4 class="mt-4">Vehicle Information</h4>
            <div class="form-group mb-3">
                <label asp-for="CarYear" class="form-label"></label>
                <input asp-for="CarYear" class="form-control" type="number" />
                <span asp-validation-for="CarYear" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="CarMake" class="form-label"></label>
                <input asp-for="CarMake" class="form-control" />
                <span asp-validation-for="CarMake" class="text-danger"></span>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="CarModel" class="form-label"></label>
                <input asp-for="CarModel" class="form-control" />
                <span asp-validation-for="CarModel" class="text-danger"></span>
            </div>

            <h4 class="mt-4">Driving History</h4>
            <div class="form-group mb-3">
                <div class="form-check">
                    <input asp-for="DUI" class="form-check-input" type="checkbox" />
                    <label asp-for="DUI" class="form-check-label">
                        Have you ever had a DUI?
                    </label>
                </div>
            </div>
            
            <div class="form-group mb-3">
                <label asp-for="SpeedingTickets" class="form-label"></label>
                <input asp-for="SpeedingTickets" class="form-control" type="number" min="0" />
                <span asp-validation-for="SpeedingTickets" class="text-danger"></span>
            </div>

            <h4 class="mt-4">Coverage Options</h4>
            <div class="form-group mb-3">
                <div class="form-check">
                    <input asp-for="CoverageType" class="form-check-input" type="checkbox" />
                    <label asp-for="CoverageType" class="form-check-label">
                        Full Coverage (Liability + Comprehensive + Collision)
                    </label>
                </div>
                <small class="form-text text-muted">Uncheck for Liability Only</small>
            </div>

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary">Get Quote</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
